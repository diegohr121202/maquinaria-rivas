---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { categorias, bySlug } from '../data/categorias';
import { wa, site } from '../data/site';

export function getStaticPaths() {
  return categorias.map((c) => ({ params: { categoria: c.slug } }));
}

const { categoria } = Astro.params;
const cat = bySlug(categoria!)!;
const url = (slug: string) => new URL(`/${slug}/`, Astro.site).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: cat.serviceType,
    serviceType: cat.serviceType,
    provider: { '@type': 'LocalBusiness', name: site.legalName, '@id': `${Astro.site?.href}#business` },
    areaServed: { '@type': 'Place', name: site.coverage },
    description: cat.metaDescription,
    url: url(cat.slug),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Equipos', item: new URL('/equipos/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: cat.kicker, item: url(cat.slug) },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: cat.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base
  title={cat.metaTitle}
  description={cat.metaDescription}
  image={`/assets/photos/${cat.heroPhoto}`}
  imageAlt={cat.heroAlt}
  fabText={cat.waText}
  preloadImage={`/assets/photos/${cat.heroPhoto}`}
  schema={schema}
>
  <!-- Hero de categoría -->
  <section class="hero" style="min-height:min(66vh,560px)">
    <div class="hero-bg" style={`background-image:url('/assets/photos/${cat.heroPhoto}')`}></div>
    <div class="hero-scrim"></div>
    <div class="wrap"><div class="hero-content">
      <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Equipos', href: '/equipos/' }, { label: cat.kicker }]} />
      <span class="over" style="margin-top:14px">{cat.kicker}</span>
      <h1>{cat.h1}</h1>
      <p class="support">{cat.intro}</p>
      <div class="hero-actions">
        <a class="btn filled state" href={wa(cat.waText)} target="_blank" rel="noopener">Cotizar por WhatsApp</a>
        <a class="btn text state" href="/equipos/">Ver todo el catálogo →</a>
      </div>
    </div></div>
  </section>

  <!-- Feature -->
  <section class="feature">
    <div class="wrap"><div class="grid">
      <div class="media-card reveal">
        <img src={`/assets/photos/${cat.featurePhoto}`} alt={cat.featureAlt} loading="lazy" />
        <span class="tag">{cat.kicker}</span>
      </div>
      <div class="reveal">
        <span class="over">{cat.kicker}</span>
        <h2>{cat.featureTitle}</h2>
        <p class="desc">{cat.featureDesc}</p>
        {cat.specs && (
          <div class="speclist">
            {cat.specs.map((s) => (
              <div class="r"><span class="rk">{s.k}</span><span class={`rv${s.hi ? ' hi' : ''}`}>{s.v}</span></div>
            ))}
          </div>
        )}
        {cat.benefits && (
          <ul class="benefits">
            {cat.benefits.map((b) => (
              <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg> {b}</li>
            ))}
          </ul>
        )}
        <a class="btn filled state" href={wa(cat.waText)} target="_blank" rel="noopener">Solicitar cotización</a>
      </div>
    </div></div>
  </section>

  <!-- Aplicaciones -->
  <section class="sec alt" aria-labelledby="usos-title">
    <div class="wrap">
      <div class="sec-head reveal"><div>
        <span class="over">Aplicaciones</span>
        <h2 id="usos-title">Dónde se usa</h2>
      </div></div>
      <div class="values reveal" style="justify-content:flex-start">
        {cat.usos.map((u) => <span>{u}</span>)}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="sec" aria-labelledby="faq-title">
    <div class="wrap">
      <div class="sec-head reveal"><div>
        <span class="over">Preguntas frecuentes</span>
        <h2 id="faq-title">Sobre {cat.kicker.toLowerCase()}</h2>
      </div></div>
      <div class="faq reveal">
        {cat.faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Relacionados -->
  <section class="sec alt" aria-labelledby="rel-title">
    <div class="wrap">
      <div class="sec-head reveal"><div>
        <span class="over">También rentamos</span>
        <h2 id="rel-title">Otros equipos para tu proyecto</h2>
      </div></div>
      <div class="cards c3">
        {cat.related.map((slug) => {
          const r = bySlug(slug)!;
          return (
            <a class="card reveal" href={`/${r.slug}/`} style="text-decoration:none">
              <div class="media"><img src={`/assets/photos/${r.heroPhoto}`} alt={r.heroAlt} loading="lazy" /></div>
              <div class="body"><h3>{r.kicker}</h3><p>{r.intro}</p></div>
              <div class="actions"><span class="btn text state" style="pointer-events:none">Ver categoría →</span></div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="ctaband">
    <div class="wrap"><div class="inner reveal">
      <h2>¿Listo para cotizar {cat.kicker.toLowerCase()}?</h2>
      <p>Cuéntanos qué necesitas y las fechas de tu proyecto. Te respondemos por WhatsApp en horario de oficina.</p>
      <a class="btn filled state" href={wa(cat.waText)} target="_blank" rel="noopener">Solicitar cotización</a>
    </div></div>
  </section>
</Base>
